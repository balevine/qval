{
  "compilerOptions": {
    "target": "ES2022",
    // DOM alongside node on purpose. The split that used to keep them apart was an electron-vite
    // artifact (main vs renderer), and it forbade the one test that matters most here: the review
    // server over `node:http` driven by the renderer's own fetch client. One program, both libs.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The pure logic lives in the plugin's `lib/*.mjs` (one copy, dependency-free, runs on bare
    // node). `allowJs` lets the TypeScript side import it; types come from the JSDoc on the exported
    // signatures, and `checkJs` stays off. The data model itself is declared in src/shared/types.ts.
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@lib/*": ["plugin/lib/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "vitest.config.ts",
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "plugin/**/*.mjs"
  ]
}
