#!/usr/bin/env node
// The Qval CLI. Two subcommands, both of them the plumbing behind a skill:
//
//   serve  [<file>] [--compare a.qval.json,b.qval.json] [--port N] [--no-open]
//          Resolve the dataset and the eval file, start the review server **detached**,
//          open a browser at it, and return immediately with the URL. Scoring 200 tickets by hand
//          takes an hour and no Bash timeout survives that, so `serve` must not block.
//
//   status [--eval-file <path>]
//          Report how the last review session ended and what is in the eval file. This is how the
//          answer gets back to Claude, since the session outlived the command that started it.
//
// `serve --child` is the detached half re-entering this file. It is internal: the parent resolves
// every path first (so a bad directory fails fast, with an exit code, rather than in a log file),
// then hands the child explicit paths and waits for it to publish a session record.
//
// Exit codes match the engine's, so the skills can branch the same way: 0 ok, 1 a bad flag, 2
// unusable state (fix the files or ask the user).
//
// Dependency-free ESM on bare node, like everything else under plugin/.

import { spawn } from 'node:child_process'
import { existsSync, promises as fs, readdirSync } from 'node:fs'
import { userInfo } from 'node:os'
import { basename, dirname, join, relative, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

import { flagValue, parseArgs } from '../lib/args.mjs'
import { atomicWriteJson, readJson } from '../lib/fsUtil.mjs'
import { normalizeSchema } from '../lib/schema.mjs'
import { normalizeRules } from '../lib/rules.mjs'
import { configFingerprint } from '../lib/fingerprint.mjs'
import { looksLikeEvalFile, normalizeEvalFile, summarizeEvalFile } from '../lib/evalFile.mjs'
import { nowIso, pidAlive } from '../lib/host.mjs'
import { defaultEvalPath, evalSearchDirs, OUTPUT_DIR, RUN_DIR, samePath } from '../lib/paths.mjs'
import { parseTicketsFile } from '../lib/tickets.mjs'
import { SettingsStore } from '../lib/settingsStore.mjs'
import { pluginVersion } from '../lib/version.mjs'
import { Workspace } from '../lib/workspace.mjs'
import { createReviewServer } from '../server/server.mjs'

const EXIT = { OK: 0, USAGE: 1, INPUT: 2 }

const SESSION_FILE = 'review-session.json'
/** The engine's config files. `serve` reads them in and writes them back, so both halves of Qval
 *  score against the same schema and rules. */
const RULES_FILE = 'EVAL_RULES.md'
const SCHEMA_FILE = 'EVAL_SCHEMA.json'
// `meta.appVersion` is read from the plugin manifest (see ../lib/version.mjs), never kept here.
/** One extra directory to look in, because Qbort (the sibling generator) puts its finished ticket
 *  files there, one timestamped file per run, and making people move it by hand would be a chore.
 *  A convenience for one known producer and nothing more: a ticket file is identified by its shape,
 *  most datasets are hand-exported and sit in the working directory, and this directory not
 *  existing is the common case rather than a problem. */
const QBORT_OUTPUT_DIR = 'qbort-output'

/** How long the parent waits for the child to publish a live session record. */
const STARTUP_TIMEOUT_MS = 20_000
/** Nobody ever opened the URL: give up rather than hold a port forever. */
const NO_CLIENT_TIMEOUT_MS = 5 * 60_000

const selfPath = fileURLToPath(import.meta.url)

function fail(line, ...rest) {
  console.error(line)
  for (const r of rest) console.error(r)
  process.exit(EXIT.INPUT)
}

function usage(line, ...rest) {
  console.error(line)
  for (const r of rest) console.error(r)
  process.exit(EXIT.USAGE)
}

/** Scratch, always `.qval-run/` under the working directory. Fixed so the engine can find the
 *  session record without being told where it is. */
const outDirOf = () => resolve(RUN_DIR)
const sessionFileOf = () => join(outDirOf(), SESSION_FILE)

// ── file resolution ───────────────────────────────────────────────────────────

const isEvalName = (name) => name.endsWith('.qval.json')

/**
 * Every `*.qval.json` Qval will consider, sorted within each location, absolute.
 *
 * Both `qval-output/` (where they go now) and the working directory itself (where every earlier
 * version put them) are scanned, so upgrading neither hides an existing evaluation nor drops it out
 * of the merge offer. The eval file deliberately does not follow the *dataset* wherever it happens
 * to live: written next to a dataset in some subdirectory it would be invisible to both halves.
 */
function evalFilesIn(dir) {
  const found = []
  for (const d of evalSearchDirs(dir)) {
    let names
    try {
      names = readdirSync(d)
    } catch {
      continue // no qval-output/ yet, which is the normal case on a first run
    }
    for (const n of names.filter(isEvalName).sort()) {
      const path = join(d, n)
      if (!found.includes(path)) found.push(path)
    }
  }
  return found
}

/** Does this file parse as ticket data? Content, never the filename, is what decides. */
async function isTicketsFile(path) {
  const raw = await readJson(path)
  return raw != null && !looksLikeEvalFile(raw) && parseTicketsFile(raw) != null
}

/**
 * Candidate ticket files in `dir` and in the `qbort-output/` below it.
 *
 * Every `.json` is opened and kept on the strength of what is inside it. Matching on the name would
 * be cheaper and would be wrong: most people bring their own export, named after wherever it came
 * from, and a scan that only recognized `tickets.json` would turn a tolerated input into a required
 * convention. The name is used only to order the results, so the conventional one is offered first.
 */
async function ticketsFilesIn(dir) {
  const found = []
  for (const d of [dir, join(dir, QBORT_OUTPUT_DIR)]) {
    let names
    try {
      names = readdirSync(d).filter((n) => n.endsWith('.json') && !isEvalName(n))
    } catch {
      continue // no such directory, which is the normal case for the optional one
    }
    names.sort((a, b) => (a === 'tickets.json' ? -1 : b === 'tickets.json' ? 1 : a.localeCompare(b)))
    for (const n of names) {
      if (await isTicketsFile(join(d, n))) found.push(join(d, n))
    }
  }
  return found
}

/** Paths as the person typed them, for a list they have to choose from. */
const forDisplay = (dir, paths) => paths.map((p) => `  ${relative(dir, p) || basename(p)}`)

/**
 * Work out what to open, from an explicit argument or by looking around the directory. Returns
 * `{ evalPath, ticketsPaths }`. `evalPath` may not exist yet, in which case the child creates it.
 *
 * This runs in the parent on purpose: an ambiguous directory is the most likely failure, and it
 * should come back as an exit code with a list, not as a line in a detached process's log.
 *
 * For an **eval file** the candidates are handed over as a list rather than resolved to one. An eval
 * file names its dataset by fingerprint, so the relink can try each in turn and a wrong guess cannot
 * mislink. Several ticket files in one directory is ordinary (accumulated exports, or one file per
 * generated run), and refusing to relink there would break re-opening a review for no reason.
 */
/**
 * The eval file a named target means, on its own, without the dataset hunt that usually goes with
 * it. A `*.qval.json` path is its own answer. Anything else has to be ticket data, and the answer
 * is the eval file `serve` would create for it.
 *
 * Split out because the live-session check needs this much and no more. Working out the dataset as
 * well can exit 2 on a directory the user is not asking about, which would turn a plain
 * `qval serve` into a failure in the one case it is there to handle.
 */
async function evalPathForTarget(target, dir) {
  const path = resolve(target)
  if (!existsSync(path)) fail(`MISSING_FILE ${path}`)
  if (isEvalName(path)) return path
  if (!(await isTicketsFile(path))) {
    fail(
      `BAD_TICKETS ${path}`,
      '  Not ticket data and not a *.qval.json eval file.',
      '  Expected `{ meta, tickets: [...] }` or a bare array, each ticket with an integer `id`.'
    )
  }
  return defaultEvalPath(dir, path)
}

async function resolveTarget(target, dir) {
  if (target) {
    const path = resolve(target)
    const evalPath = await evalPathForTarget(target, dir)
    if (isEvalName(path)) {
      // Look for the dataset in the working directory *and* beside the eval file. An eval file now
      // lives in `qval-output/`, which holds no tickets, and one passed in from someone else's
      // directory may have its dataset there instead. The fingerprint picks which is right, so
      // offering both can't mislink. Offering neither is what would fail.
      const beside = dirname(path) === dir ? [] : await ticketsFilesIn(dirname(path))
      return { evalPath, ticketsPaths: [...new Set([...(await ticketsFilesIn(dir)), ...beside])] }
    }
    return { evalPath, ticketsPaths: [path] }
  }

  const evals = evalFilesIn(dir)
  if (evals.length === 1) return { evalPath: evals[0], ticketsPaths: await ticketsFilesIn(dir) }
  if (evals.length > 1) {
    fail(
      `AMBIGUOUS ${evals.length} eval files in ${dir}`,
      ...forDisplay(dir, evals),
      '  Pass the one to review: `qval serve <file>.qval.json`.'
    )
  }

  const tickets = await ticketsFilesIn(dir)
  if (tickets.length === 0) {
    fail(
      `NO_DATASET ${dir}`,
      `  No .json here (or in ./${QBORT_OUTPUT_DIR}/) holds ticket data, and there is no *.qval.json`,
      `  here or in ./${OUTPUT_DIR}/ either.`,
      '  Pass the path to your ticket file: `qval serve <path>`. It can live anywhere.',
      '  Ticket data is `{ meta, tickets: [...] }` or a bare array, each ticket with an integer `id`.'
    )
  }
  // Starting a *new* evaluation is the one case with nothing to disambiguate on, so several
  // datasets have to be put to the user. Accumulated exports and per-run generated files both
  // land here, so this is routine rather than a sign something is wrong.
  if (tickets.length > 1) {
    fail(
      `AMBIGUOUS ${tickets.length} ticket files in ${dir}`,
      ...forDisplay(dir, tickets),
      '  Pass the one to review: `qval serve <file>.json`.'
    )
  }
  return { evalPath: defaultEvalPath(dir, tickets[0]), ticketsPaths: [tickets[0]] }
}

/**
 * The paths on offer to MERGE: every other `*.qval.json` next to the working file, plus anything
 * named with `--compare`. Order is what the ids are assigned from, so it has to survive the trip
 * to the child. Hence paths here and `comparisonSources` there, rather than ids in two places.
 */
function resolveCandidatePaths(args, dir, evalPath) {
  const explicit = (flagValue(args, 'compare') ?? '')
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean)
    .map((p) => resolve(p))
  const paths = []
  for (const p of [...evalFilesIn(dir), ...explicit]) {
    if (p !== evalPath && !paths.includes(p)) paths.push(p)
  }
  return paths
}

/**
 * The offer as the workspace takes it. The browser is shown the `id` and the `name` only, which is
 * what keeps paths off the wire; the id is positional, so this is the one place that mints one.
 */
const comparisonSources = (paths) => paths.map((path, i) => ({ id: `c${i + 1}`, name: basename(path), path }))

// ── the engine's config files, shared both ways ───────────────────────────────

/**
 * Seed the working schema and rules from `EVAL_SCHEMA.json` / `EVAL_RULES.md` when they exist, so a
 * review opened on a bare tickets.json starts from the same config `/qval:evaluate-tickets` would
 * use. Without this the two halves of Qval quietly disagree and the eval files stop merging.
 * Skipped for an eval file, which carries its own authoritative config snapshot.
 */
async function seedConfigFromEngineFiles(settings, dir) {
  const patch = {}
  const rawSchema = await readJson(join(dir, SCHEMA_FILE))
  if (Array.isArray(rawSchema)) {
    const schema = normalizeSchema(rawSchema)
    if (schema.length) patch.schema = schema
  }
  try {
    patch.rules = normalizeRules(await fs.readFile(join(dir, RULES_FILE), 'utf8'))
  } catch {
    /* no rules file: keep what settings already hold */
  }
  if (Object.keys(patch).length) await settings.set(patch)
}

/** The config fingerprint of whatever settings hold right now. Taken before and after the session,
 *  so the write-back below can tell an edit from a no-op. */
async function currentConfigFingerprint(settings) {
  const s = await settings.get()
  return configFingerprint(s.schema, s.rules)
}

/**
 * The other direction, once the session is over: write the config the person actually used back out
 * for the engine to read, so a schema built in the browser is one `/qval:evaluate-tickets` can run.
 *
 * **Only when they changed it.** These are files in the user's working directory that they may well
 * have written by hand, and a session opened on an older eval file loads *that file's* config into
 * settings. Writing unconditionally would stamp an archived schema over the current one just for
 * looking at an old result. Comparing fingerprints keeps the write to the case it exists for.
 */
async function writeConfigForEngine(settings, dir, seededFingerprint) {
  const s = await settings.get()
  if (!s.schema.length) return false
  if (configFingerprint(s.schema, s.rules) === seededFingerprint) return false
  await fs.mkdir(dir, { recursive: true })
  await fs.writeFile(join(dir, SCHEMA_FILE), `${JSON.stringify(s.schema, null, 2)}\n`, 'utf8')
  await fs.writeFile(join(dir, RULES_FILE), s.rules.endsWith('\n') ? s.rules : `${s.rules}\n`, 'utf8')
  return true
}

// ── the session record ────────────────────────────────────────────────────────

/**
 * Write the record `status` reads back. Owner-only, because a live record holds the URL and the URL
 * holds the session token. The mode is set as the file is created rather than corrected afterwards,
 * so the token is never on disk at the default umask, not even for the width of one write.
 */
async function writeRecord(path, record) {
  await atomicWriteJson(path, record, { mode: 0o600 })
}

// ── serve (parent) ────────────────────────────────────────────────────────────

async function cmdServe(args) {
  if (args.child) return cmdServeChild(args)

  const dir = process.cwd()
  const outDir = outDirOf()
  const recordPath = sessionFileOf()

  // A session already running here is the common re-ask ("open it again"), not an error. It is only
  // that when the file it holds is the file being asked for, though. One session runs per
  // directory (this record is named from the working directory, not from any eval file), so asking
  // for a second file is a request that cannot be met, and handing back the running session's URL
  // would answer it with somebody else's evaluation.
  const existing = await readJson(recordPath)
  if (existing?.status === 'live' && pidAlive(existing.pid)) {
    const asked = args._[0] ? await evalPathForTarget(args._[0], dir) : null
    if (asked && existing.workingPath && !samePath(asked, existing.workingPath)) {
      fail(
        `ALREADY_SERVING_OTHER_FILE ${asked}`,
        '  A review session is already open in this directory, on a different eval file.',
        `  OPEN ${existing.workingPath}`,
        '  Only one session runs per directory, so that one has to end before this one can start.',
        '  Ask the user to click FINISH in that tab, then re-run.',
        `  URL ${existing.url ?? '(unknown)'}`
      )
    }
    console.log('ALREADY_SERVING')
    console.log(`URL ${existing.url}`)
    console.log(`WORKING_FILE ${existing.workingPath}`)
    return
  }

  const { evalPath, ticketsPaths } = await resolveTarget(args._[0], dir)
  const candidatePaths = resolveCandidatePaths(args, dir, evalPath)

  const port = flagValue(args, 'port')
  if (port !== null && !/^\d+$/.test(port)) usage(`BAD_PORT ${port}`, '  --port takes a number.')

  await fs.mkdir(outDir, { recursive: true })
  const sessionId = `${process.pid}-${Date.now()}`

  const childArgs = [
    selfPath,
    'serve',
    '--child',
    '--session',
    sessionId,
    '--eval-file',
    evalPath,
    '--dir',
    dir
  ]
  if (ticketsPaths.length) childArgs.push('--tickets', ticketsPaths.join(','))
  if (candidatePaths.length) childArgs.push('--compare', candidatePaths.join(','))
  if (port !== null) childArgs.push('--port', port)
  if (args['no-open']) childArgs.push('--no-open')

  // Nothing to capture: the child prints nothing, and every error it can anticipate goes into the
  // session record below, which is where `status` reads it from and where the parent reads it here.
  const child = spawn(process.execPath, childArgs, {
    cwd: dir,
    detached: true,
    stdio: 'ignore'
  })
  child.unref()

  // Wait for the child to publish. This is the only synchronization point: after it, the parent is
  // done and the session outlives it.
  const deadline = Date.now() + STARTUP_TIMEOUT_MS
  for (;;) {
    const record = await readJson(recordPath)
    if (record?.sessionId === sessionId) {
      if (record.status === 'error') {
        fail(`SERVER_FAILED ${record.error ?? 'unknown error'}`)
      }
      if (record.status === 'live') {
        console.log('SERVING')
        console.log(`URL ${record.url}`)
        console.log(`WORKING_FILE ${record.workingPath}`)
        if (record.datasetPath) console.log(`DATASET ${record.datasetPath}`)
        console.log(`CANDIDATES ${record.candidates.length}`)
        console.log(`OPENED ${record.opened ? 'yes' : 'no'}`)
        return
      }
    }
    if (Date.now() > deadline) {
      fail(
        'SERVER_TIMEOUT the review server did not start.',
        `  It was given ${STARTUP_TIMEOUT_MS / 1000} seconds and never reported in.`,
        '  Try again; if it keeps happening, check that node runs on this machine.'
      )
    }
    await new Promise((r) => setTimeout(r, 100))
  }
}

// ── serve (detached child) ────────────────────────────────────────────────────

/**
 * Hand the URL to a browser. Two ways this goes wrong and both are silent, which is why the URL is
 * printed either way:
 *
 * `$BROWSER` is a documented override, and Claude Code's agent view sets it to the literal `true`.
 * Shelling out naively there runs `true <url>`, which exits 0 without opening anything and leaves
 * the session waiting for a tab that will never arrive. So the sentinel values are treated as "no
 * browser here", not as a command.
 */
function browserCommand(url) {
  const raw = process.env.BROWSER
  if (raw !== undefined) {
    const cmd = raw.trim()
    const sentinels = new Set(['', 'true', 'false', 'none', 'echo', ':', 'cat', '0', '1'])
    if (sentinels.has(cmd.toLowerCase())) return null
    return { cmd, args: [url] }
  }
  if (process.platform === 'darwin') return { cmd: 'open', args: [url] }
  if (process.platform === 'win32') return { cmd: 'cmd', args: ['/c', 'start', '', url] }
  return { cmd: 'xdg-open', args: [url] }
}

/** @returns {boolean} whether we managed to hand the URL to anything. */
function openBrowser(url) {
  const opener = browserCommand(url)
  if (!opener) return false
  try {
    const child = spawn(opener.cmd, opener.args, { detached: true, stdio: 'ignore' })
    child.on('error', () => {
      /* no such opener: the printed URL is the fallback */
    })
    child.unref()
    return true
  } catch {
    return false
  }
}

async function cmdServeChild(args) {
  const sessionId = flagValue(args, 'session')
  const outDir = outDirOf()
  const recordPath = join(outDir, SESSION_FILE)
  const dir = flagValue(args, 'dir') ?? process.cwd()
  const evalPath = flagValue(args, 'eval-file')
  const ticketsPaths = (flagValue(args, 'tickets') ?? '').split(',').filter(Boolean)
  const comparePaths = (flagValue(args, 'compare') ?? '').split(',').filter(Boolean)

  const base = {
    app: 'qval-review',
    sessionId,
    pid: process.pid,
    startedAt: nowIso(),
    endedAt: null,
    workingPath: evalPath,
    // A guess until the open resolves it, since an eval file may be given several candidates and
    // only the fingerprint says which one it is. Overwritten below with the one actually loaded.
    datasetPath: ticketsPaths[0] ?? null,
    candidates: comparePaths.map((p) => basename(p))
  }

  const settings = new SettingsStore(outDir)
  const appVersion = await pluginVersion()
  const workspace = new Workspace(settings, appVersion)
  let server = null

  try {
    // The name stamped on the human evaluator. The OS username is a better first guess than a
    // placeholder, and it stays editable in the browser.
    const current = await settings.get()
    if (!current.evaluatorName) {
      let username = 'Me'
      try {
        username = userInfo().username || 'Me'
      } catch {
        /* userInfo throws in some sandboxes */
      }
      await settings.set({ evaluatorName: username })
    }

    if (existsSync(evalPath)) {
      // Resuming: the file's own config snapshot wins, and its dataset is relinked by fingerprint,
      // which is what picks the right one out of the candidates the parent found.
      await workspace.open(evalPath, async () => ticketsPaths)
    } else {
      // A new evaluation, so the parent has already refused anything but a single dataset.
      if (!ticketsPaths.length) throw new Error(`${evalPath} does not exist and no tickets file was given.`)
      await seedConfigFromEngineFiles(settings, dir)
      await workspace.open(ticketsPaths[0])
      await workspace.save(evalPath)
    }
    // Taken after the open, so it reflects whatever the session actually starts from (the eval
    // file's own snapshot, or the seeded engine files). What it is compared against at the end.
    const seededFingerprint = await currentConfigFingerprint(settings)
    base.datasetPath = (await settings.get()).lastDatasetPath ?? base.datasetPath
    workspace.setComparisonSources(comparisonSources(comparePaths))

    server = createReviewServer({ workspace, settings, appVersion })
    const url = await server.listen(Number(flagValue(args, 'port') ?? 0))
    const opened = args['no-open'] ? false : openBrowser(url)

    await writeRecord(recordPath, { ...base, status: 'live', url, port: server.port, opened, error: null })

    // Nobody ever took the lease: the browser never opened and never will. Ending here beats
    // holding a port and a token open indefinitely.
    const abandonedByNobody = new Promise((r) => {
      const t = setTimeout(() => {
        if (!server.everConnected) r({ reason: 'abandoned', workingPath: workspace.currentPath() })
      }, NO_CLIENT_TIMEOUT_MS)
      t.unref?.()
    })

    const outcome = await Promise.race([server.finished, abandonedByNobody])
    await server.close()
    // The person may have rewritten the schema or the rules in the browser; hand that back to the
    // engine so a follow-up `/qval:evaluate-tickets` scores against what they actually used. A
    // session that changed neither leaves their files alone.
    const configWritten = await writeConfigForEngine(settings, dir, seededFingerprint)
    await writeRecord(recordPath, {
      ...base,
      status: outcome.reason,
      endedAt: nowIso(),
      configWritten,
      // The URL carries the token, and the token dies with the session.
      url: null,
      port: null,
      opened: null,
      workingPath: outcome.workingPath ?? evalPath,
      error: null
    })
  } catch (err) {
    await server?.close()
    await writeRecord(recordPath, {
      ...base,
      status: 'error',
      endedAt: nowIso(),
      url: null,
      port: null,
      opened: null,
      error: err instanceof Error ? err.message : String(err)
    })
    process.exit(EXIT.INPUT)
  }
}

// ── status ───────────────────────────────────────────────────────────────────

async function cmdStatus(args) {
  const recordPath = sessionFileOf()
  const record = await readJson(recordPath)

  if (!record) {
    console.log('REVIEW none')
  } else if (record.status === 'live' && !pidAlive(record.pid)) {
    // The process died without recording an outcome (killed, machine restarted). Say so rather
    // than reporting a session that is not there.
    console.log('REVIEW stale')
    console.log(`STARTED ${record.startedAt}`)
  } else {
    console.log(`REVIEW ${record.status}`)
    if (record.status === 'live') {
      console.log(`URL ${record.url}`)
      if (!record.opened) console.log('OPENED no')
    }
    if (record.endedAt) console.log(`ENDED ${record.endedAt}`)
    // Only printed when it happened, because it means two files in the working directory changed.
    if (record.configWritten) console.log(`CONFIG_WRITTEN ${SCHEMA_FILE}, ${RULES_FILE}`)
    if (record.error) console.log(`ERROR ${record.error}`)
  }

  const evalPath = flagValue(args, 'eval-file') ?? record?.workingPath ?? null
  if (!evalPath) return
  const file = normalizeEvalFile(await readJson(evalPath))
  if (!file) {
    console.log(`NO_EVAL_FILE ${evalPath}`)
    return
  }

  // No fingerprints here: this answers "how far along is this?", not "what may be scored onto it".
  for (const line of summarizeEvalFile(file, evalPath)) console.log(line)
}

// ── dispatch ─────────────────────────────────────────────────────────────────

const argv = process.argv.slice(2)
const cmd = argv[0]
const args = parseArgs(argv.slice(1))

switch (cmd) {
  case 'serve':
    await cmdServe(args)
    break
  case 'status':
    await cmdStatus(args)
    break
  default:
    console.error('Usage: qval <serve|status> [options]  (see the file header)')
    process.exit(EXIT.USAGE)
}
